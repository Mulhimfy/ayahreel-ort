{
    "build_abis": [
        "armeabi-v7a",
        "arm64-v8a",
        "x86_64"
    ],
    "android_min_sdk_version": 24,
    "android_target_sdk_version": 34,
    "build_params": [
        "--enable_lto",
        "--android",
        "--parallel",
        "--cmake_generator=Ninja",
        "--build_java",
        "--build_shared_lib",
        "--minimal_build",
        "--disable_ml_ops",
        "--enable_reduced_operator_type_support",
        "--skip_tests",
        "--cmake_extra_defines=onnxruntime_BUILD_UNIT_TESTS=OFF",
        "--compile_no_warning_as_error"
    ]
}